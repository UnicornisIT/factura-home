{
  "name": "glina-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "cd ../admin && npm run dev",
    "dev:all": "concurrently -n shop,admin -c blue,magenta \"npm run dev\" \"npm run dev:admin\"",
    "build": "vite build && npm run build:admin && esbuild api/boot.ts --platform=node --bundle --format=esm --packages=external --outdir=dist --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);const __filename = import.meta.url.slice(7);const __dirname = __filename.slice(0, __filename.lastIndexOf('/'));\"",
    "build:admin": "cd ../admin && npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node dist/boot.js",
    "check": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx db/migrate.ts",
    "seed": "tsx db/seed.ts",
    "seed:dev": "npm run seed",
    "format:check": "prettier --check .",
    "test:deployment": "tsx tests/deployment-smoke.ts",
    "test:mysql": "tsx tests/mysql-smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.16",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "better-sqlite3": "^11.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.8.3",
    "mysql2": "^3.14.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.6.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@hono/vite-dev-server": "^0.19.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.1.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true
  },
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10"
  }
}
