[Unit]
Description=Factura Shop (витрина, админ-панель, API)
Documentation=https://github.com/UnicornisIT/factura-home
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@/app
# Конфигурация читается из app/.env через dotenv относительно WorkingDirectory.
# EnvironmentFile опционален (-): для серверов с отдельным конфигом юнита.
EnvironmentFile=-/etc/factura/factura.env
ExecStart=/usr/bin/node dist/boot.js
Restart=on-failure
RestartSec=5
# NoNewPrivileges не включается: обновлению из панели нужна sudoers-запись
# на /usr/local/sbin/factura-update.sh (см. deployment/sudoers-factura-update).
# Обновление из панели переносит себя в transient unit systemd-run и не зависит
# от рестарта сервиса; KillMode=process — второй рубеж: systemctl restart внутри
# скрипта убивает только основной процесс, а скрипт (та же cgroup) доживает до
# healthcheck и записи статуса.
# ReadWritePaths ограничен данными и логами: каталоги root-скрипта обновления
# (/usr/local/sbin) и юнитов (/etc/systemd/system) намеренно НЕ входят — сервис
# не должен иметь возможности их перезаписать. Их переустанавливает root-скрипт
# из transient unit, который работает вне mount namespace сервиса.
KillMode=process
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=@RW_PATHS@

[Install]
WantedBy=multi-user.target
